{
  "name": "run-a-police-tickets",
  "version": "0.1.0",
  "private": true,
  "description": "Single-guild Discord ticket bot and administrative panel for Run a Police.",
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node index.js",
    "dev": "tsx watch src/index.ts",
    "test": "tsx --test tests/ticket-flow.test.ts",
    "register-commands": "tsx src/register-commands.ts",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "engines": { "node": ">=20.11" },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "discord.js": "^14.22.1",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "zod": "^4.1.5"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
