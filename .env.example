NODE_ENV=production
# Bot-Hosting injects SERVER_PORT; PORT is the local development fallback.
PORT=3000
HOST=0.0.0.0
# Mantén esta ruta en el almacenamiento persistente del servidor (no en /tmp).
DATABASE_PATH=./data/run-a-police.sqlite
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://YOUR-SUBDOMAIN.apps.bot-hosting.cloud/auth/callback
DISCORD_GUILD_ID=
SESSION_SECRET=replace-with-at-least-32-random-bytes
APP_BASE_URL=https://YOUR-SUBDOMAIN.apps.bot-hosting.cloud
# Optional bootstrap: Discord role IDs allowed full admin access; configure more in the panel later.
BOOTSTRAP_ADMIN_ROLE_IDS=
